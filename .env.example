# supportal — config/secrets. Do NOT commit a real .env. In production, secrets come from pass/vault/a secret manager.

# Telegram (operator side)
SUPPORT_TG_BOT_TOKEN=            # support bot token (@BotFather); a dedicated support bot is recommended
SUPPORT_TG_GROUP_ID=            # chat_id of the support forum supergroup (usually negative; the bot is an admin with "Manage topics")
SUPPORT_TG_PROXY=               # forward-proxy egress to Telegram (empty → direct; bypasses an IPv6 blocker, e.g. http://user:pass@host:port)

# Contour A — browser widget (primary)
SUPPORT_WIDGET_SECRET=          # secret SHARED with the product for signing the widget access token (the product mints, the relay verifies)
SUPPORT_ALLOWED_ORIGIN=         # product origin for CORS (local cross-origin dev; empty → no CORS, same-origin in production)

# Contour B — via the product (optional; empty → callback/outbox dormant)
SUPPORT_PRODUCT_CALLBACK_URL=   # where to POST the operator reply (product adapter), e.g. http://<product>:PORT/support/push
SUPPORT_CALLBACK_SECRET=        # HMAC relay → product
SUPPORT_INGRESS_SECRET=         # HMAC product → relay

# Storage and network
SUPPORT_DB_URL=sqlite:///./supportal.db
SUPPORT_HTTP_PORT=8500

# Feature flags (default off). You can enable them here (env) OR in settings.yaml (hot, no restart).
# Priority: settings.yaml → env → default. See settings.yaml.example and README "Feature flags".
SUPPORT_RATE_LIMIT=off             # anti-spam on POST /v1/widget/send (per user_ref)
SUPPORT_RATE_LIMIT_MAX=20          # messages per window
SUPPORT_RATE_LIMIT_WINDOW=60       # window length, s
SUPPORT_ATTACHMENTS=off            # file attachments (images inline, other files as links); bytes stored in the DB
SUPPORT_ATTACHMENTS_MAX_MB=10      # max upload size, MB
SUPPORT_VISITOR_CONTEXT=off        # post a one-time "visitor context" block (page URL/title + custom fields) into a new topic
# Localization: the widget's own copy is supplied by the product via /support/config ("strings").
# This is the only server-generated user-facing line — set it to localize the ticket-closed notice.
SUPPORT_CLOSED_NOTICE=This ticket was closed by the operator.

# Re-delivery of an operator reply to an offline user (outbox, contour B). All optional (defaults in code).
SUPPORT_OUTBOX_RETRY_INTERVAL=30   # background retry period, s
SUPPORT_OUTBOX_TTL=86400           # keep an undelivered reply until "give up", s
SUPPORT_OUTBOX_MAX_ATTEMPTS=12     # delivery attempt ceiling
SUPPORT_OUTBOX_BACKOFF_BASE=30     # base backoff delay, s
SUPPORT_OUTBOX_BACKOFF_CAP=1800    # backoff delay ceiling, s

SUPPORT_LOG_LEVEL=INFO
