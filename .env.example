# supportal — конфиг/секреты. НЕ коммитить реальный .env. В проде секреты — из pass/vault/секрет-менеджера.

# Telegram (сторона оператора)
SUPPORT_TG_BOT_TOKEN=            # токен бота поддержки (@BotFather); рекомендуется отдельный бот поддержки
SUPPORT_TG_GROUP_ID=            # chat_id forum-супергруппы поддержки (обычно отрицательный; бот — админ с «Управление темами»)
SUPPORT_TG_PROXY=               # forward-proxy egress к Telegram (пусто → напрямую; обход IPv6-блокера, напр. http://user:pass@host:port)

# Контур A — браузерный виджет (основной)
SUPPORT_WIDGET_SECRET=          # ОБЩИЙ с продуктом секрет подписи токена доступа виджета (продукт чеканит, relay проверяет)
SUPPORT_ALLOWED_ORIGIN=         # origin продукта для CORS (локальный кросс-оригин dev; пусто → без CORS, same-origin в проде)

# Контур B — через продукт (опц.; пусто → callback/outbox дормант)
SUPPORT_PRODUCT_CALLBACK_URL=   # куда POST'ить ответ оператора (адаптер продукта), напр. http://<продукт>:PORT/support/push
SUPPORT_CALLBACK_SECRET=        # HMAC relay → продукт
SUPPORT_INGRESS_SECRET=         # HMAC продукт → relay

# Хранилище и сеть
SUPPORT_DB_URL=sqlite:///./supportal.db
SUPPORT_HTTP_PORT=8500

# Фичи за флагами (дефолт off). Можно включать здесь (env) ИЛИ в settings.yaml (горячо, без рестарта).
# Приоритет: settings.yaml → env → дефолт. См. settings.yaml.example и README «Feature flags».
SUPPORT_RATE_LIMIT=off             # анти-спам на POST /v1/widget/send (по user_ref)
SUPPORT_RATE_LIMIT_MAX=20          # сообщений в окне
SUPPORT_RATE_LIMIT_WINDOW=60       # длина окна, с

# Повторная доставка ответа оператора оффлайн-пользователю (outbox, контур B). Все — опциональны (дефолты в коде).
SUPPORT_OUTBOX_RETRY_INTERVAL=30   # период фонового повтора, с
SUPPORT_OUTBOX_TTL=86400           # держим неотданный ответ до «сдаёмся», с
SUPPORT_OUTBOX_MAX_ATTEMPTS=12     # потолок попыток доставки
SUPPORT_OUTBOX_BACKOFF_BASE=30     # базовая задержка backoff, с
SUPPORT_OUTBOX_BACKOFF_CAP=1800    # потолок задержки backoff, с

SUPPORT_LOG_LEVEL=INFO
