# dali-support — конфиг/секреты. НЕ коммитить реальный .env. В контуре ДаЛи секреты — из pass/vault.
SUPPORT_TG_BOT_TOKEN=            # токен бота поддержки (@BotFather); можно отдельный от @dali_alerts_bot
SUPPORT_TG_GROUP_ID=            # chat_id forum-супергруппы поддержки (обычно отрицательный; бот — админ с «Управление темами»)
SUPPORT_PRODUCT_CALLBACK_URL=   # куда POST'ить ответ оператора (адаптер продукта), напр. http://rca-chat:8200/support/push
SUPPORT_CALLBACK_SECRET=        # HMAC relay → продукт
SUPPORT_INGRESS_SECRET=         # HMAC продукт → relay
SUPPORT_DB_URL=sqlite:///./dali_support.db
SUPPORT_HTTP_PORT=8500
RCA_LOG_LEVEL=INFO
