# supportal — feature flags as settings (optional).
#
# Copy to `settings.yaml` (same dir, or point SUPPORT_SETTINGS_FILE at it) to toggle
# features WITHOUT a restart — the service re-reads the file by mtime on each request.
# Keys are the env-var names. Priority: settings.yaml > environment > code default.
# Only behavior flags belong here — never secrets, ports, tokens or DB URLs (those stay in .env).

# Rate limit on POST /v1/widget/send (anti-spam, per user_ref). Default: off.
SUPPORT_RATE_LIMIT: off
SUPPORT_RATE_LIMIT_MAX: 20        # messages allowed within the window
SUPPORT_RATE_LIMIT_WINDOW: 60     # window length, seconds

# File attachments both ways (images rendered inline, other files as download links). Bytes are
# stored in the DB, bounded by the size cap. Default: off.
SUPPORT_ATTACHMENTS: off
SUPPORT_ATTACHMENTS_MAX_MB: 10    # max upload size, MB

# Post a one-time "visitor context" block (page URL/title + any custom fields the page supplies via
# window.supportalContext) into a newly created topic, so the operator sees where the user is. Default: off.
SUPPORT_VISITOR_CONTEXT: off

# CSAT: after the operator closes a ticket, the widget shows a 1..5 star prompt; the rating lands in the
# feed and is posted into the ticket's topic. The product must also expose csat:true in /support/config. Default: off.
SUPPORT_CSAT: off

# Business hours / auto-away: when a ticket is opened outside the schedule, the user gets a one-time
# "we're away" auto-reply (in the widget + a note in the topic). Default: off. A schedule is required
# (empty → the feature stays inert). Grammar: ";"-separated "<days> HH:MM-HH:MM" clauses; <days> is a
# range (mon-fri), a single day (sat) or a comma list (mon,wed,fri). end < start crosses midnight.
SUPPORT_BUSINESS_HOURS: off
# SUPPORT_HOURS: mon-fri 09:00-18:00; sat 10:00-14:00
# SUPPORT_HOURS_TZ: Europe/Moscow           # IANA timezone; default UTC
# SUPPORT_AWAY_MESSAGE: Thanks for reaching out! We're away right now and will reply during business hours.

# Canned responses: the operator sends a preset reply by typing "/c <key>" in the topic ("/c" alone lists
# the keys). Replies are a key→text map (here a YAML mapping; via env a "k=v;k=v" string). Default: off.
SUPPORT_CANNED: off
# SUPPORT_CANNED_REPLIES:
#   greeting: "Hi! Thanks for reaching out — how can I help?"
#   hours: "We're open Mon–Fri, 9:00–18:00."

# Read receipts: the widget reports what the user has seen → the operator learns the user read their reply
# (a 👀 reaction on the message in Telegram) and the user sees a delivered tick. Needs receipts:true in
# /support/config for the widget side. Default: off.
SUPPORT_RECEIPTS: off

# OpenAPI docs: expose Swagger /docs + ReDoc /redoc + /openapi.json. Off by default (the relay usually sits
# behind the product's reverse-proxy). ⚠️ Read at STARTUP only — change it, then restart the service.
SUPPORT_OPENAPI: off

# GDPR data-subject operations: POST /v1/admin/export|delete {user_ref} (HMAC-signed, contour B) export or
# hard-erase everything stored for a user_ref (messages, attachments, tickets, Telegram topics). Default: off.
SUPPORT_GDPR: off

# Observability: expose GET /metrics in Prometheus text format (tickets/messages/attachments/outbox gauges).
# Unauthenticated — only expose it on an internal network / scrape target. Default: off.
SUPPORT_METRICS: off

# Localization. The widget's UI copy is supplied by the product via /support/config ("strings");
# the ticket-closed notice is the only server-generated user-facing line — localize it here.
# SUPPORT_CLOSED_NOTICE: This ticket was closed by the operator.
