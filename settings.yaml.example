# supportal — feature flags as settings (optional).
#
# Copy to `settings.yaml` (same dir, or point SUPPORT_SETTINGS_FILE at it) to toggle
# features WITHOUT a restart — the service re-reads the file by mtime on each request.
# Keys are the env-var names. Priority: settings.yaml > environment > code default.
# Only behavior flags belong here — never secrets, ports, tokens or DB URLs (those stay in .env).

# Rate limit on POST /v1/widget/send (anti-spam, per user_ref). Default: off.
SUPPORT_RATE_LIMIT: off
SUPPORT_RATE_LIMIT_MAX: 20        # messages allowed within the window
SUPPORT_RATE_LIMIT_WINDOW: 60     # window length, seconds

# File attachments both ways (images rendered inline, other files as download links). Bytes are
# stored in the DB, bounded by the size cap. Default: off.
SUPPORT_ATTACHMENTS: off
SUPPORT_ATTACHMENTS_MAX_MB: 10    # max upload size, MB
